<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arkaplan">

    <!-- Sohbet basligi: uygulama adi + durum satiri (okuyucu, kayit, jeton). -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yuzey"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/baslik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/baslik"
            android:textColor="@color/yazi"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/durum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/yazi_silik"
            android:text="@string/yukleniyor" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yuzey_sinir" />

    <!-- Mesaj akisi: balonlar programatik ekleniyor (AndroidX yok). -->
    <ScrollView
        android:id="@+id/kaydirma"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/akis"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yuzey_sinir" />

    <!-- Giris cubugu: soru kutusu + gonder + belge -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yuzey"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/soru"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/soru_ipucu"
            android:textColorHint="@color/yazi_silik"
            android:textColor="@color/yazi"
            android:backgroundTint="@color/yazi_silik"
            android:inputType="textMultiLine"
            android:minLines="1"
            android:maxLines="4" />

        <Button
            android:id="@+id/dugme_belge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/dugme_belge" />

        <Button
            android:id="@+id/dugme_sor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/dugme_sor" />
    </LinearLayout>
</LinearLayout>
